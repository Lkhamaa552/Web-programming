<!DOCTYPE html>
<html>
<head>
  <title>Interactive Color Palette</title>

  <style>
    body {
      font-family: system-ui;
      padding: 30px;
      max-width: 700px;
      margin: auto;
    }

    h1 {
      color: #1a56db;
      text-align: center;
    }

    .add-row {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
    }

    input {
      flex: 1;
      padding: 10px;
      border: 2px solid #c8d4f0;
      border-radius: 8px;
      font-size: 16px;
    }

    button {
      padding: 10px 16px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      background: #1a56db;
      color: white;
      font-weight: bold;
    }

    #palette {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .color-box {
      height: 120px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: bold;
      cursor: pointer;
      transition: all 0.3s;
      text-shadow: 0 1px 3px black;
    }

    .color-box.expanded {
      height: 180px;
      transform: scale(1.05);
    }

    .color-code {
      display: none;
    }

    .color-box.expanded .color-code {
      display: block;
    }
  </style>
</head>

<body>

  <h1>🎨 Interactive Color Palette</h1>

  <div class="add-row">
    <input
      id="color-input"
      type="text"
      placeholder="Enter HEX color, e.g. #ff5733"
    >

    <button id="add-btn">+ Add Color</button>
  </div>

  <div id="palette"></div>


  <script>

    const colorInput = document.querySelector('#color-input');
    const addBtn = document.querySelector('#add-btn');
    const palette = document.querySelector('#palette');


    // 6 default colors
    const colors = [
      '#1a56db',
      '#dc2626',
      '#16a34a',
      '#9333ea',
      '#f59e0b',
      '#0891b2'
    ];


    // Create color box
    function createColorBox(color) {

      const box = document.createElement('div');

      box.classList.add('color-box');

      box.style.backgroundColor = color;


      const code = document.createElement('span');

      code.classList.add('color-code');

      code.textContent = color;


      box.appendChild(code);

      palette.appendChild(box);


      // Click → expand
      box.addEventListener('click', function() {

        box.classList.toggle('expanded');

      });


      // Double click → delete
      box.addEventListener('dblclick', function() {

        box.remove();

      });

    }


    // Create 6 default boxes
    colors.forEach(function(color) {

      createColorBox(color);

    });


    // Add new color
    addBtn.addEventListener('click', function() {

      const color = colorInput.value.trim();

      if (color === '') {
        return;
      }

      createColorBox(color);

      colorInput.value = '';

    });


    // Enter → Add Color
    colorInput.addEventListener('keydown', function(e) {

      if (e.key === 'Enter') {

        addBtn.click();

      }

    });

  </script>

</body>
</html>